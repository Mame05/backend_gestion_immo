// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
   url      = env("DATABASE_URL")
 

}

enum Role {
  ADMIN
  AGENCE
  CLIENT
}

enum StatutBien {
  LIBRE
  OCCUPE
}

enum Categorie{
  MOYEN
  LUXE
}

enum TypeTransaction {
  LOCATION
  VENTE
}

enum PeriodePaiement {
  MOIS
  ANNEE
  UNIQUE
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRMEE
  ANNULEE
}

model User {
  id           Int           @id @default(autoincrement())
  nom_complet  String
  email        String        @unique
  mot_passe    String
  role         Role          @default(CLIENT)
  createdAt DateTime  @default(now())
  biens        BienImmobilier[]
  commentaires Commentaire[]
  reservations Reservation[]
}

model BienImmobilier {
  id              Int           @id @default(autoincrement())
  nom             String
  categorie       Categorie   
  image           String?
  description     String
  adresse         String
  statut          StatutBien    @default(LIBRE)
  montant         Int              // ex: 50000 ou 50000000
  typeTransaction TypeTransaction
  periodePaiement PeriodePaiement? // null si vente
  agenceId     Int
  agence       User          @relation(fields: [agenceId], references: [id])
  commentaires Commentaire[]
  reservations Reservation[]
  images       ImageBien[]

  createdAt       DateTime         @default(now())
}

model ImageBien {
  id        Int    @id @default(autoincrement())
  url       String
  publicId String
  bienId    Int
  bien      BienImmobilier @relation(fields: [bienId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Commentaire {
  id                  Int     @id @default(autoincrement())
  contenu             String
  note                Int     @default(0) // ⭐ note de 1 à 5
  date_publication    DateTime @default(now())
  clientId            Int
  bienId              Int
  client              User     @relation(fields: [clientId], references: [id])
  bien                BienImmobilier @relation(fields: [bienId], references: [id])
}

model Reservation {
  id          Int      @id @default(autoincrement())
  dateDebut   DateTime
  dateFin     DateTime?
  statut      StatutReservation   @default(EN_ATTENTE)
  clientId    Int
  bienId      Int
  client      User     @relation(fields: [clientId], references: [id])
  bien        BienImmobilier @relation(fields: [bienId], references: [id])

  createdAt   DateTime          @default(now())
}
